# The database password is generated by Terraform and stored in Secrets Manager. Nobody types it, Git never sees it.
resource "random_password" "db" {
  length  = 32
  special = false # URL-safe, so it can go straight into DATABASE_URL
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${var.name}/db-password"
  recovery_window_in_days = 0 # lab setting: delete immediately on destroy
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id     = aws_secretsmanager_secret.db.id
  secret_string = random_password.db.result
}
